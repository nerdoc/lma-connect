#: templates/base.html
msgid "Open this page in Safari (other browsers cannot install apps on iOS)."
msgstr "Diese Seite in Safari öffnen (andere Browser können auf iOS keine Apps installieren)."

#: templates/base.html
msgid ""
"Tap the <strong>share button</strong> <i class=\"ti ti-share-2\"></i> at the "
"bottom of the screen."
msgstr ""
"Unten auf den <strong>Teilen-Button</strong> <i class=\"ti ti-share-2\"></i> "
"tippen."

#: templates/base.html
msgid "Choose <strong>Add to Home Screen</strong>, then <strong>Add</strong>."
msgstr "<strong>Zum Home-Bildschirm</strong> wählen, dann <strong>Hinzufügen</strong>."

#: templates/base.html
msgid "Open the browser menu <i class=\"ti ti-dots-vertical\"></i> (top right)."
msgstr "Das Browser-Menü <i class=\"ti ti-dots-vertical\"></i> (oben rechts) öffnen."

#: templates/base.html
msgid ""
"Choose <strong>Add to Home screen</strong> or <strong>Install app</strong>, "
"then confirm."
msgstr ""
"<strong>Zum Startbildschirm hinzufügen</strong> oder <strong>App "
"installieren</strong> wählen und bestätigen."

#: templates/base.html
msgid ""
"In Chrome or Edge, click the <strong>install icon</strong> in the address "
"bar, or open the browser menu and choose <strong>Install app</strong>."
msgstr ""
"In Chrome oder Edge auf das <strong>Installieren-Symbol</strong> in der "
"Adressleiste klicken oder im Browser-Menü <strong>App installieren</strong> "
"wählen."

#: templates/base.html
msgid ""
"Safari on Mac: File → Add to Dock. Firefox has no install option — use a "
"bookmark."
msgstr ""
"Safari am Mac: Ablage → Zum Dock hinzufügen. Firefox bietet keine "
"Installation — ein Lesezeichen verwenden."

#: templates/base.html
msgid "Close"
msgstr "Schließen"
