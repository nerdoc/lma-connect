# LMA Connect — environment variables
# Copy to .env (dev) and adjust. .env is gitignored.

# ─── Core ───
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-django-cryptos-output-in-prod
# Keep 127.0.0.1 and localhost in the list: without them a local /healthz
# check on the server answers 400 (DisallowedHost).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Sub-path deployment (e.g. example.org/conference/).
# When set, Django generates every URL with that prefix and scopes the
# cookies to it. Register the Uberspace backend with `--prefix keep`.
# DJANGO_FORCE_SCRIPT_NAME=/conference

# ─── Database ───
# Dev: SQLite (default — leave as is)
DB_ENGINE=sqlite

# Prod: MariaDB / MySQL
# DB_ENGINE=mariadb
# DB_NAME=lma_connect
# DB_USER=lma_connect
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# SQLite under load — the defaults are normally fine, see
# docs/backup-und-lastfestigkeit.md.
# busy_timeout in seconds (Django's default would be 5, we use 20):
# DJANGO_SQLITE_TIMEOUT=20
# Lifetime of persistent DB connections in seconds (0 = new one per request):
# DJANGO_CONN_MAX_AGE=60

# ─── Backups ───
# Target directory for `manage.py backup_db`. Default: ~/backups/lma-connect
# DJANGO_BACKUP_DIR=/home/youruser/backups/lma-connect

# ─── Sessions ───
# Session cookie lifetime in seconds (default: 14 days)
# DJANGO_SESSION_COOKIE_AGE=1209600

# ─── Security (prod) ───
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000

# ─── django-axes — brute-force protection ───
# DJANGO_AXES_ENABLED=True
# DJANGO_AXES_FAILURE_LIMIT=10
# DJANGO_AXES_COOLOFF_HOURS=1
# Behind a reverse proxy (Uberspace) set the number of proxies:
# DJANGO_AXES_PROXY_COUNT=1

# ─── Content-Security-Policy ───
# During roll-out start with REPORT_ONLY, then set it to False to enforce.
# DJANGO_CSP_REPORT_ONLY=False

# ─── Token redeem throttling (brute-force protection for /t/<token>/) ───
# 20 invalid tokens per IP within 60 s → 15 min lockout (429).
# DJANGO_TOKEN_WINDOW_SECONDS=60
# DJANGO_TOKEN_MAX_FAILS=20
# DJANGO_TOKEN_LOCKOUT_SECONDS=900
